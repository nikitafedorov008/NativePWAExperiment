{
  "name": "native-pwa-experiment",
  "description": "Proof of concept: a PWA that behaves like a native mobile/desktop app, including the UI",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "canvas-confetti": "^1.9",
    "react": "^18.3",
    "react-dom": "^18.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2",
    "sharp": "^0.35",
    "typescript": "^5.7.2",
    "vite": "^7.3",
    "vite-plugin-pwa": "^1.3",
    "vitest": "^5"
  }
}
